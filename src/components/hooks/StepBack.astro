---
import ArrowLeft from "../../assets/ArrowLeft.astro";

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="animate-fade-in">
  <button
    class="ml-6 inline-flex items-center space-x-2 text-sm text-gray-600 hover:text-blue-600 transition-colors duration-200 bg-white/70 backdrop-blur-sm rounded-lg px-3 py-2 shadow-md"
    onclick="history.back()">
    <ArrowLeft />
    <span class="font-medium">{title}</span>
  </button>
</div>
