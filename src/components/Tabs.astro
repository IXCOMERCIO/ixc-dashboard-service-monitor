---
export interface Props {
  titles: string[];
}

const { titles } = Astro.props;
const tabCount = titles.length;
---

<div class="w-full rounded-lg bg-white p-2">
  <div class="relative">
    <div id="tab-indicator" class="absolute bottom-0 h-0.5 transition-all duration-300 ease-in-out"></div>

    <div class="flex justify-around" id="tabs-header">
      {titles.map((title, i) => (
        <button
          type="button"
          class={`tab-button relative w-full py-4 text-center text-sm font-medium border-b-2 transition-colors text-gray-600 ${
            title === 'Pagos' ? 'hover:text-green-600 hover:border-green-600' :
            title === 'Consumer' ? 'hover:text-purple-600 hover:border-purple-600' : 'hover:text-blue-500 hover:border-blue-500'}`
          }
          data-index={i}
        >
          {title}
        </button>
      ))}
    </div>
  </div>

  <div class="mt-6" id="tabs-panels">
    <slot />
  </div>
</div>

<script type="module">
  const buttons = document.querySelectorAll(".tab-button");
  const panels = document.querySelectorAll(".tab-content");
  const indicator = document.getElementById("tab-indicator");

  function showTab(index) {
    buttons.forEach((btn, i) => {
      btn.classList.toggle(`${i === 0 ?  'text-green-600' : i === 1 ? 'text-blue-500' : 'text-purple-600'}`, i === index);
      btn.classList.toggle(`${i === 0 ?  'border-green-600' : i === 1 ? 'border-blue-500' : 'border-purple-600'}`, i === index);
    });

    panels.forEach((panel, i) => {
      if (i === index) {
        panel.classList.remove("hidden");
        panel.classList.add("block");
      } else {
        panel.classList.add("hidden");
        panel.classList.remove("block");
      }
    });

    const activeBtn = buttons[index];
    const offsetLeft = activeBtn.offsetLeft;
    const width = activeBtn.offsetWidth;
    indicator.style.width = width + "px";
    indicator.style.left = offsetLeft + "px";
  }

  buttons.forEach((btn, i) => {
    btn.addEventListener("click", () => showTab(i));
  });

  window.addEventListener("DOMContentLoaded", () => showTab(0));
</script>
