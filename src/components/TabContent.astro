---
import ServiceCard from './services/ServiceCard.astro';

export interface Props {
  items: {
    id: string;
    title: string;
    description: string;
    status: "Healthy" | "Critical" | "Warning";
    services: string;
    responseTime: string;
  }[];
}

const { items } = Astro.props;

console.log('Datos recibidos en TabContent:', items);
---

{items?.length === 0 ? (
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {Array.from({ length: 3 }).map(() => (
      <div class="animate-pulse border rounded-lg p-4 bg-gray-100 shadow">
        <div class="h-4 w-3/4 bg-gray-300 rounded mb-2"></div>
        <div class="h-3 w-1/2 bg-gray-300 rounded mb-3"></div>
        <div class="h-3 w-full bg-gray-300 rounded mb-2"></div>
        <div class="h-3 w-5/6 bg-gray-300 rounded mb-2"></div>
        <div class="h-3 w-2/3 bg-gray-300 rounded"></div>
      </div>
    ))}
  </div>
) : (
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {items?.map((item) => (
      <ServiceCard
        title={item.title}
        description={item.description}
        status={item.status}
        services={item.services}
        responseTime={item.responseTime}
        detailsHref={`/monitor/${item.id}`}
        historyHref={`/historic/${item.id}`}
      />
    ))}
  </div>
)}
