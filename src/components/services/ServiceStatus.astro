---
import ArchitectureDiagram from "../architecture/ArchitectureDiagram.jsx";
import TestFlow from "../architecture/TestFlow.jsx";
import { Icon } from "astro-icon/components";

export interface Props {
  services: {
    title: string;
    description: string;
    serviceState: {
      online: number;
      offline: number;
      averageResponseTime: number;
      lastUpdated: string;
    };
    services: Record<string, any>;
  };
  isDetail: boolean;
}

const { services, isDetail } = Astro.props;
console.log(
  "-------------------------Services----------------------:",
  services
);
const serviceList = Object.values(services.services);

const onlineCount = serviceList.filter(
  (s) => s.overallStatus?.status === "healthy"
).length;
const offlineCount = serviceList.filter(
  (s) => s.overallStatus?.status === "critical"
).length;
const degradedCount = serviceList.filter(
  (s) => s.overallStatus?.status === "warning"
).length;

console.log("Service List:", JSON.stringify(serviceList, null, 2));

const avgResponseTime = services.serviceState.averageResponseTime ?? 0;
---

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.8;
    }
  }
  
  .animate-fade-in {
    animation: fadeInUp 0.4s ease-out;
  }
  
  .glass-effect {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(229, 231, 235, 0.4);
  }
  
  .hover-scale {
    transition: all 0.2s ease;
  }
  
  .hover-scale:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.08);
  }
  
  .hover-row {
    transition: all 0.15s ease;
  }
  
  .hover-row:hover {
    background: rgba(59, 130, 246, 0.03);
    transform: translateX(2px);
  }
  
  .status-dot {
    position: relative;
  }
  
  .status-dot::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: inherit;
    animation: pulse 3s infinite;
    opacity: 0.4;
  }
</style>

<div class="w-full mx-auto px-4 sm:px-6 mt-4 space-y-4">
  <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
    <!-- Columna izquierda -->
    <div class="flex flex-col gap-4 animate-fade-in">
      <!-- Paneles de estado compactos -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <!-- Estado de servicios -->
        <div class="glass-effect rounded-xl shadow-lg p-4 hover-scale border-l-4 border-blue-400">
          <div class="flex items-center mb-3">
            <div class="w-8 h-8 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 00-2-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-gray-800">Estado de Servicios</h3>
              <p class="text-xs text-gray-500">Resumen general</p>
            </div>
          </div>
          
          <div class="grid grid-cols-3 gap-2">
            <div class="text-center p-2 bg-gradient-to-br from-green-50 to-emerald-50 rounded-lg border border-green-100">
              <div class="w-6 h-6 bg-green-500 rounded-full mx-auto mb-1 flex items-center justify-center">
                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div class="text-xl font-bold text-green-700">{onlineCount}</div>
              <div class="text-xs font-medium text-green-600 uppercase tracking-wider">Online</div>
            </div>
            
            <div class="text-center p-2 bg-gradient-to-br from-yellow-50 to-amber-50 rounded-lg border border-yellow-100">
              <div class="w-6 h-6 bg-yellow-500 rounded-full mx-auto mb-1 flex items-center justify-center">
                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L4.732 18.5c-.77.833.192 2.5 1.732 2.5z"></path>
                </svg>
              </div>
              <div class="text-xl font-bold text-yellow-700">{degradedCount}</div>
              <div class="text-xs font-medium text-yellow-600 uppercase tracking-wider">Warning</div>
            </div>
            
            <div class="text-center p-2 bg-gradient-to-br from-red-50 to-rose-50 rounded-lg border border-red-100">
              <div class="w-6 h-6 bg-red-500 rounded-full mx-auto mb-1 flex items-center justify-center">
                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </div>
              <div class="text-xl font-bold text-red-700">{offlineCount}</div>
              <div class="text-xs font-medium text-red-600 uppercase tracking-wider">Offline</div>
            </div>
          </div>
        </div>

        <!-- Tiempo de respuesta -->
        <div class="glass-effect rounded-xl shadow-lg p-4 hover-scale border-l-4 border-purple-400">
          <div class="flex items-center mb-3">
            <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-pink-500 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-gray-800">Tiempo de Respuesta</h3>
              <p class="text-xs text-gray-500">Promedio actual</p>
            </div>
          </div>
          
          <div class="text-center">
            <div class="text-2xl font-bold bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent mb-1">
              {avgResponseTime}
            </div>
            <div class="text-sm font-medium text-gray-600">milisegundos</div>
            <div class="mt-2 flex items-center justify-center">
              <span class="status-dot w-2 h-2 bg-purple-500 rounded-full mr-2"></span>
              <span class="text-xs text-gray-500">Tiempo óptimo</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Lista de servicios compacta -->
      <div class="glass-effect rounded-xl shadow-lg p-4 hover-scale">
        <div class="flex items-center mb-4">
          <div class="w-8 h-8 bg-gradient-to-r from-indigo-500 to-blue-500 rounded-lg flex items-center justify-center mr-3">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-gray-800">Servicios Activos</h3>
            <p class="text-xs text-gray-500">{serviceList.length} servicios monitoreados</p>
          </div>
        </div>
        
        <div class="overflow-hidden rounded-lg border border-gray-100">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-gradient-to-r from-gray-50 to-gray-100">
                <th class="px-3 py-2 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Estado</th>
                <th class="px-3 py-2 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Servicio</th>
                <th class="px-3 py-2 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Ejecución</th>
                <th class="px-3 py-2 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Disponibilidad</th>
                <th class="px-3 py-2 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Info</th>
              </tr>
            </thead>
            <tbody class="bg-white/50 divide-y divide-gray-100">
              {serviceList.map((s, index) => (
                <tr class="hover-row">
                  <td class="px-3 py-2">
                    <span
                      class={`status-dot w-3 h-3 rounded-full inline-block ${
                        s.overallStatus?.status === "healthy"
                          ? "bg-green-500"
                          : s.overallStatus?.status === "warning"
                            ? "bg-yellow-500"
                            : "bg-red-500"
                      }`}
                      title={s.overallStatus?.status}
                    />
                  </td>
                  <td class="px-3 py-2">
                    <div class="font-medium text-gray-800 text-sm">{s.serviceName}</div>
                    <div class="text-xs text-gray-500">Servicio #{index + 1}</div>
                  </td>
                  <td class="px-3 py-2">
                    <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-blue-100 text-blue-700">
                      {s.executionTime && s.executionTime !== "UNKNOWN"
                        ? s.executionTime
                        : "--"}
                    </span>
                  </td>
                  <td class="px-3 py-2">
                    <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-green-100 text-green-700">
                      {s.disponibility && s.disponibility !== "UNKNOWN"
                        ? s.disponibility
                        : "--"}
                    </span>
                  </td>
                  <td class="px-3 py-2">
                    {s.status !== 200 && (
                      <div class="relative group inline-block">
                        <Icon
                          name="material-symbols:help"
                          class="w-4 h-4 text-red-500 cursor-pointer"
                        />
                        <div class="absolute z-10 hidden group-hover:block top-full mt-2 right-0 px-3 py-2 text-sm text-white bg-red-500 rounded shadow whitespace-normal max-w-md break-words">
                          <div class="mb-1"><span class="font-bold">Código del error:</span> {s.status || "N/A"}</div>
                          <div>{s.response || "N/A"}</div>
                          <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 rotate-45 w-3 h-3 bg-red-500 mb-1"/>
                        </div>
                      </div>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Diagrama de Arquitectura compacto -->
    <div class="glass-effect rounded-xl shadow-lg p-4 hover-scale animate-fade-in min-h-[400px]" style="animation-delay: 0.2s">
      <div class="flex items-center mb-4">
        <div class="w-8 h-8 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-lg flex items-center justify-center mr-3">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-gray-800">
            {isDetail ? "Diagrama de Arquitectura" : "Flujo de Pruebas"}
          </h3>
          <p class="text-xs text-gray-500">
            {isDetail ? "Vista detallada del sistema" : "Esquema de testing"}
          </p>
        </div>
      </div>
      
      <div class="bg-gradient-to-br from-gray-50 to-blue-50 rounded-lg p-4 min-h-[350px] flex items-center justify-center border border-gray-100">
        {
          isDetail ? (
            <ArchitectureDiagram client:visible service={services} />
          ) : (
            <TestFlow client:visible />
          )
        }
      </div>
    </div>
  </div>
</div>