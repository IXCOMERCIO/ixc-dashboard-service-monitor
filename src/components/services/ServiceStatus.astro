---
import ArchitectureDiagram from "../architecture/ArchitectureDiagram.jsx";
import TestFlow from "../architecture/TestFlow.jsx";

export interface Props {
  services: {
    title: string;
    description: string;
    serviceState: {
      online: number;
      offline: number;
      averageResponseTime: number;
      lastUpdated: string;
    };
    services: Record<string, any>;
  };
  isDetail: boolean;
}

const { services, isDetail } = Astro.props;
//console.log("-------------------------Services----------------------:", services);
const serviceList = Object.values(services.services);
//console.log("Service List:", serviceList);

const onlineCount = serviceList.filter(
  (s) => s.overallStatus?.status === "healthy"
).length;
const offlineCount = serviceList.filter(
  (s) => s.overallStatus?.status === "critical"
).length;
const degradedCount = serviceList.filter(
  (s) => s.overallStatus?.status === "warning"
).length;

const avgResponseTime =
  serviceList.length > 0
    ? Math.round(
        serviceList.reduce((sum, s) => sum + parseFloat(s.executionTime), 0) /
          serviceList.length
      )
    : 0;
---

<div class="w-full max-w-6xl mx-auto px-4 sm:px-6 mt-6 space-y-6">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Columna izquierda -->
    <div class="flex flex-col gap-4">
      <!-- Paneles de estado -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div
          class="flex flex-col justify-between bg-white border p-4 rounded-lg shadow-sm"
        >
          <div class="text-sm text-gray-500 mb-2">Service Status</div>
          <div class="grid grid-cols-3 gap-2 text-center">
            <div>
              <div class="text-xl font-bold">{onlineCount}</div>
              <div class="text-xs text-green-600">Online</div>
            </div>
            <div>
              <div class="text-xl font-bold">{degradedCount}</div>
              <div class="text-xs text-yellow-600">Warning</div>
            </div>
            <div>
              <div class="text-xl font-bold">{offlineCount}</div>
              <div class="text-xs text-red-600">Offline</div>
            </div>
          </div>
        </div>

        <div
          class="flex flex-col justify-between bg-white border p-4 rounded-lg shadow-sm"
        >
          <div class="text-sm text-gray-500 mb-2">Average Response Time</div>
          <div class="text-xl font-bold">{avgResponseTime} ms</div>
        </div>
      </div>

      <!-- Lista de subservicios -->
      <div class="bg-white p-4 border rounded-lg shadow-sm">
        <div class="text-sm text-gray-500 mb-2">Subservices</div>
        <table
          class="table-auto w-full text-sm text-left text-gray-800 border-collapse"
        >
          <thead>
            <tr class="bg-gray-100 text-gray-600 uppercase text-xs">
              <th class=" py-2"></th>
              <th class=" py-2">Servicio</th>
              <th class=" py-2">Tiempo de ejecución</th>
              <th class=" py-2">Disponibilidad</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            {
              serviceList.map((s) => (
                <tr>
                  <td class="px-4 py-2">
                    <span
                      class={`w-3 h-3 inline-block rounded-full ${
                        s.overallStatus?.status === "healthy"
                          ? "bg-green-300"
                          : s.overallStatus?.status === "warning"
                            ? "bg-yellow-300"
                            : "bg-red-300"
                      }`}
                      title={s.overallStatus?.status}
                    />
                  </td>
                  <td class="py-2">{s.serviceName}</td>
                  <td class="py-2">{s.executionTime}</td>
                  <td class="py-2">{s.disponibility}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- Diagrama de Arquitectura -->
    <div
      class="bg-white p-4 border rounded-lg shadow-sm flex items-center justify-center"
    >
      {
        isDetail ? (
          <ArchitectureDiagram client:visible service={services} />
        ) : (
          <TestFlow client:visible />
        )
      }
    </div>
  </div>
</div>
