---
import ServiceStatus from "./ServiceStatus.astro";
import ArchitectureDiagram from "../architecture/ArchitectureDiagram.jsx";
import type { SubService } from "../interfaces/DashboardInterfaces";
import { SHOW_GENERAL_STATUS } from 'astro:env/server';

export interface Props {
  serviceDetail: {
    title: string;
    description: string;
    serviceState: {
      online: number;
      offline: number;
      averageResponseTime: number;
      lastUpdated: string;
    };
    services: Record<string, any>;
  };
  subservices: SubService[];
}

const { serviceDetail } = Astro.props;
//console.log("Service Detail uwu:", serviceDetail);
---

<div>
  <!-- Subservicios -->
  <ServiceStatus services={serviceDetail} isDetail={true} />
</div>