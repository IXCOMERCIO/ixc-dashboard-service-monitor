---
import ServiceStatus from "./ServiceStatus.astro";
import ArchitectureDiagram from "../architecture/ArchitectureDiagram.jsx";
import type { SubService } from "../interfaces/DashboardInterfaces";
import { SHOW_GENERAL_STATUS } from 'astro:env/server';

export interface Props {
  serviceDetail: {
    title: string;
    description: string;
    serviceState: {
      online: number;
      offline: number;
      averageResponseTime: number;
      lastUpdated: string;
    };
    services: Record<string, any>;
  };
  subservices: SubService[];
}

const { serviceDetail } = Astro.props;
//console.log("Service Detail uwu:", serviceDetail);
---

<div>
{
    SHOW_GENERAL_STATUS &&(<div class="bg-white p-6 rounded-lg shadow">
    <h2 class="text-xl font-bold mb-4">Estado General</h2>
    <p class="text-gray-700">{serviceDetail.description}</p>
    <div class="mt-4">
      <p><strong>Online:</strong> {serviceDetail.serviceState?.online}</p>
      <p><strong>Offline:</strong> {serviceDetail.serviceState?.offline}</p>
      <p><strong>Tiempo de Respuesta Promedio:</strong> {serviceDetail.serviceState?.averageResponseTime} ms</p>
      <p><strong>Última Actualización:</strong> {new Date(serviceDetail.serviceState?.lastUpdated).toLocaleString()}</p>
    </div>
  </div>)
}

  <!-- Subservicios -->
  <ServiceStatus services={serviceDetail} isDetail={true} />
</div>