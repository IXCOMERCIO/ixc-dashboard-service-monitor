---
import ArrowRight from "../../assets/ArrowRight.astro"
import DetailButton from "../hooks/DetailButton.astro";
export interface Props {
  service: string;
  title: string;
  description: string;
  status: 'Healthy' | 'Warning' | 'Critical';
  services: string;
  responseTime: string;
  serviceStatusPercentage: number;
  detailsHref: string;
  historyHref: string;
}

const { title, description, status, services, responseTime, serviceStatusPercentage, detailsHref, historyHref } = Astro.props;

const statusColor = {
  Healthy: 'bg-green-500',
  Warning: 'bg-yellow-500',
  Critical: 'bg-red-500',
};

const borderColor = {
  Healthy: 'border-green-200',
  Warning: 'border-yellow-300',
  Critical: 'border-red-200',
};
---

<div class={`rounded-lg border bg-white text-gray-700 shadow-sm overflow-hidden ${borderColor[status]}`}>
  <!-- Header -->
  <div class="flex flex-col space-y-1.5 p-6 pb-0">
    <div class="flex justify-between items-start">
      <h3 class="font-semibold tracking-tight text-base">{title}</h3>
      <div class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold text-white ${statusColor[status]}`}>
        {status}
      </div>
    </div>
  </div>

  <!-- Body -->
  <div class="p-6 pt-0 pb-2">
    <div class="text-xs text-gray-500 mb-5">{description}</div>

    <div class="grid grid-cols-2 gap-4 mb-4">
      <div>
        <div class="text-sm text-gray-500 mb-1">Servicios</div>
        <div class="flex items-center gap-2">
          <span class={`inline-flex w-3 h-3 rounded-full ${statusColor[status]}`}></span>
          <span class="font-medium">{services}</span>
        </div>
      </div>
      <div>
        <div class="text-sm text-gray-500 mb-1">Respuesta Promedio</div>
        <div class="font-medium">{responseTime}</div>
      </div>
    </div>

    <div class="space-y-2">
      <div class="text-sm text-gray-500 mb-1">Estado de los servicios</div>
      <div class="w-full bg-gray-200 rounded-full h-2.5">
        <div class={`h-2.5 rounded-full ${statusColor[status]}`} style={`width: ${serviceStatusPercentage}%`}></div>
      </div>
    </div>
  </div>

  <!-- Footer buttons -->
  <div class="flex items-center p-6 pt-1 gap-4">
    <DetailButton href={detailsHref} title="Ver Detalles" />
    <DetailButton href={historyHref} title="Ver Histórico" />
  </div>
</div>
