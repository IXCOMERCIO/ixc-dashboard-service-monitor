---
export interface Props {
    title: string;
    subtitle: string;
    isLoading: boolean;
}

const { title, subtitle, isLoading } = Astro.props;
---

<head>
    <meta charset="utf-8" />
</head>

<div
    class="bg-white/80 backdrop-blur-md border-b border-gray-200/50 sticky top-0 z-50"
>
    <div class="mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex items-center justify-between">
            <!-- Logo y título (lado izquierdo) -->
            <div class="flex items-center space-x-4">
                <div
                    class="w-12 h-12 bg-gradient-to-r from-blue-600 to-purple-600 rounded-xl flex items-center justify-center shadow-lg"
                >
                    <svg
                        class="w-6 h-6 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 00-2-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                        ></path>
                    </svg>
                </div>
                <div>
                    <h1
                        class="text-2xl font-bold bg-gradient-to-r from-gray-900 to-gray-600 bg-clip-text text-transparent"
                    >
                        {
                            isLoading
                                ? "Cargando..."
                                : title || "Error en el Servicio"
                        }
                    </h1>
                    <p class="text-sm text-gray-500 flex items-center">
                        <svg
                            class="w-4 h-4 mr-2"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path>
                        </svg>
                        {subtitle}
                    </p>
                </div>
            </div>

            <!-- Controles del lado derecho -->
            <div class="flex items-center space-x-3">
                <!-- Información del usuario -->
                <div
                    class="flex items-center space-x-3 bg-white/60 backdrop-blur-sm rounded-xl px-4 py-2 border border-gray-200/50"
                >
                    <div class="text-right">
                        <p
                            class="text-sm font-semibold text-gray-900"
                            id="userDisplayName"
                        >
                            <span class="animate-pulse">Cargando...</span>
                        </p>
                        <p class="text-xs text-gray-500" id="userLoginTime">
                            --
                        </p>
                    </div>
                    <!-- <div class="w-8 h-8 bg-gradient-to-r from-orange-400 to-orange-600 rounded-lg flex items-center justify-center shadow-md">
                        <span class="text-sm">🦁</span>
                    </div> -->
                </div>

                <!-- Botón de refrescar -->
                <button
                    id="refreshButton"
                    class="px-4 py-2 bg-gradient-to-r from-blue-500 to-blue-600 text-white rounded-lg hover:from-blue-600 hover:to-blue-700 transition-all duration-200 shadow-lg flex items-center space-x-2 group"
                    title="Refrescar datos"
                >
                    <svg
                        class="w-4 h-4 group-hover:rotate-180 transition-transform duration-500"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                        ></path>
                    </svg>
                    <span class="text-sm font-medium">Refrescar</span>
                </button>

                <!-- Botón de logout -->
                <button
                    id="logoutButton"
                    class="px-4 py-2 bg-gradient-to-r from-red-500 to-red-600 text-white rounded-lg hover:from-red-600 hover:to-red-700 transition-all duration-200 shadow-lg flex items-center space-x-2 group"
                    title="Cerrar sesión"
                >
                    <svg
                        class="w-4 h-4 group-hover:translate-x-0.5 transition-transform duration-200"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                        ></path>
                    </svg>
                    <span class="text-sm font-medium">Logout</span>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* animacion pal user */
    @keyframes fadeInUser {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .user-info-loaded {
        animation: fadeInUser 0.5s ease-out;
    }

    button {
        transform-origin: center;
    }

    button:active {
        transform: scale(0.98);
    }

    .user-container {
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }
</style>

<script>
    // Función para formatear el tiempo de login
    function formatLoginTime(dateString) {
        const date = new Date(dateString);
        const now = new Date();
        const diffMs = now - date;
        const diffMins = Math.floor(diffMs / 60000);
        const diffHours = Math.floor(diffMs / 3600000);

        // Array de chistes aleatorios de LINCES 🦁
        const chistes = [
            "Rugiendo desde el login 🦁",
            "Más conectado que un WiFi LINCES 📶",
            "Online como un verdadero felino 🐾",
            "Cazando bugs desde que llegaste 🐛",
            "Monitoreando como los grandes 👑",
            "Código limpio, como melena de LINCE ✨",
            "Tu uptime es del 99.9% como nosotros 📊",
            "Debugging mode: LINCE activado 🔍",
            "Tu conexión vale oro como nuestro equipo 🏆",
            "Healthcheck aprobado por LINCES 💚",
            "Session-time: Nivel LINCE alcanzado 🎯",
            "Tu login fue tan smooth como un LINCE 🌟",
            "Dashboard premium activado 👨‍💻",
            "Productividad nivel: EQUIPO LINCES 🚀",
            "API calls faster than a LINCE hunt 💨",
            "Server response: RUGIDO aprobado 📢",
        ];

        const seed = Math.floor(diffMins / 1);
        const chiste = chistes[seed % chistes.length];

        return chiste;
    }

    // function para actulizar info del user
    function updateUserInfo() {
        const userInfo = localStorage.getItem("userInfo");

        if (userInfo) {
            try {
                const user = JSON.parse(userInfo);
                const displayName = `¡Hola, ${user.username}! 🦁`;
                const loginTime = formatLoginTime(user.loginTime);

                // actualiza los elementos
                const nameElement = document.getElementById("userDisplayName");
                const timeElement = document.getElementById("userLoginTime");

                // actualiza el contenido
                if (nameElement && timeElement) {
                    nameElement.textContent = displayName;
                    timeElement.textContent = loginTime;
                    nameElement.classList.add("user-info-loaded");
                }
            } catch (e) {
                console.error("Error parsing user info:", e);
                const nameEl = document.getElementById("userDisplayName");
                if (nameEl) nameEl.textContent = "❌ Error al cargar usuario";
            }
        } else {
            window.location.href = "/login";
        }
    }

    // para cuando se desconecte
    function handleLogout() {
        // Primera confirmación
        if (confirm("¿Estás seguro que quieres cerrar sesión? 🦁")) {
            // Segunda confirmación más divertida
            if (
                confirm(
                    "Segurito seguritooo??? 🦁\n\n¿De verdad quieres abandonar a los LINCES? 😿",
                )
            ) {
                const userInfo = localStorage.getItem("userInfo");

                // efecto visual de cierre
                const button = document.getElementById("logoutButton");
                if (button) {
                    button.textContent = "Cerrando...";
                    button.disabled = true;
                }

                document.body.style.opacity = "0.7";

                setTimeout(() => {
                    if (userInfo) {
                        try {
                            const user = JSON.parse(userInfo);
                            alert(
                                `¡Hasta pronto, ${user.username}! 🦁\nGracias por ser parte del team LINCES\n\n¡Nos vemos en la próxima cacería de bugs! 🐛`,
                            );
                        } catch (e) {
                            alert(
                                "¡Hasta pronto! 🦁\n¡Que los LINCES te acompañen!",
                            );
                        }
                    }

                    // limpia la sesion
                    localStorage.removeItem("authToken");
                    localStorage.removeItem("userInfo");

                    // chao cookies
                    document.cookie =
                        "authToken=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";

                    // de vuelta al login
                    window.location.href = "/login";
                }, 1000);
            } else {
                // Si cancela la segunda confirmación
                alert(
                    "ejo ejooo acomodese y sientese para tomar un tecito",
                );
            }
        } else {
            // Si cancela la primera confirmación
            alert("¡Excelente decisión! 🦁");
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        // ver la autenticación
        const authToken = localStorage.getItem("authToken");
        if (!authToken) {
            window.location.href = "/login";
            return;
        }

        updateUserInfo();

        setInterval(updateUserInfo, 60000);

        // boton de refreshhhhh
        document
            .getElementById("refreshButton")
            ?.addEventListener("click", () => {
                const button = document.getElementById("refreshButton");
                if (button) {
                    const spanElement = button.querySelector("span");
                    if (spanElement) {
                        spanElement.textContent = "Refrescando...";
                    }
                    button.disabled = true;

                    setTimeout(() => {
                        window.location.reload();
                    }, 500);
                }
            });

        // boton de logout
        document
            .getElementById("logoutButton")
            ?.addEventListener("click", handleLogout);
    });
</script>
