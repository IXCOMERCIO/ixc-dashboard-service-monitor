---
import Tabs from '../components/Tabs.astro';
import TabItem from '../components/TabItem.astro';
import TabContent from '../components/TabContent.astro';
import Header from '../components/layouts/Header.astro';
import { BASE_DASHBOARD_URL } from 'astro:env/server';
import type { DashboardData, Service } from '../components/interfaces/DashboardInterfaces';

const res = await fetch(`${BASE_DASHBOARD_URL}/dashboard`);
if (!res.ok) {
  throw new Error(`Failed to fetch data from ${BASE_DASHBOARD_URL}/dashboard`);
}
const data: DashboardData = await res.json();

const mapStatus = (status: string): "Healthy" | "Critical" | "Warning" => {
  switch (status.toLowerCase()) {
    case "healthy":
      return "Healthy";
    case "critical":
      return "Critical";
    case "warning":
      return "Warning";
    default:
      throw new Error(`Invalid status: ${status}`);
  }
};

const generateCards = (services: Record<string, Service>) =>
  Object.entries(services).map(([key, service]) => ({
    id: key,
    title: service.title,
    description: service.description,
    status: mapStatus(service.overallStatus.status),
    services: `${service.serviceState.online}/${service.serviceState.online + service.serviceState.offline} Online`,
    responseTime: `${service.serviceState.averageResponseTime} ms`,
    serviceStatusPercentage: (service.serviceState.online / (service.serviceState.online + service.serviceState.offline)) * 100
  }));

const sections = [
  { title: 'Pagos', service: 'payments', cards: generateCards(data.payments) },
  { title: 'Logística', service: 'logistic', cards: generateCards(data.logistic) },
  { title: 'Consumer', service: 'consumer', cards: generateCards(data.consumer) },
];
---

<!-- Header -->
<Header title="Dashboard Healthcheck" subtitle="Desafío Q2" />

<!-- Tab layout -->
<div class="mx-auto px-4 mt-6">
  <Tabs titles={sections.map(section => section.title)}>
    {sections.map((section, index) => (
      <TabItem index={index} title={section.title} active={index === 0}>
        <TabContent service={section.service} items={section.cards} />
      </TabItem>
    ))}
  </Tabs>
</div>
