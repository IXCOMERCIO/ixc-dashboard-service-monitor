---
// src/pages/index.astro
import Tabs from '../components/Tabs.astro';
import TabItem from '../components/TabItem.astro';
import TabContent from '../components/TabContent.astro';
import Header from '../components/layouts/Header.astro';
import SLAStatus from '../components/services/SLAStatus.astro';
import type { DashboardData, Service } from '../components/interfaces/DashboardInterfaces';
import { mockSLAs } from '../data/mockSLA';

const BASE_DASHBOARD_URL = import.meta.env.BASE_DASHBOARD_URL || 'http://localhost:3000';

// Verificar que la variable de entorno esté configurada en producción
if (!import.meta.env.BASE_DASHBOARD_URL && import.meta.env.PROD) {
  throw new Error('BASE_DASHBOARD_URL environment variable is required in production');
}

const res = await fetch(`${BASE_DASHBOARD_URL}/dashboard`);
if (!res.ok) {
  throw new Error(`Failed to fetch data from ${BASE_DASHBOARD_URL}/dashboard`);
}
const data: DashboardData = await res.json();

const mapStatus = (status: string): "Healthy" | "Critical" | "Warning" => {
  switch (status.toLowerCase()) {
    case "healthy":
      return "Healthy";
    case "critical":
      return "Critical";
    case "warning":
      return "Warning";
    default:
      throw new Error(`Invalid status: ${status}`);
  }
};

const generateCards = (services: Record<string, Service>) =>
  Object.entries(services).map(([key, service]) => ({
    id: key,
    title: service.title,
    description: service.description,
    status: mapStatus(service.overallStatus.status),
    services: `${service.serviceState.online}/${service.serviceState.online + service.serviceState.offline} Online`,
    responseTime: `${service.serviceState.averageResponseTime} ms`,
    serviceStatusPercentage: (service.serviceState.online / (service.serviceState.online + service.serviceState.offline)) * 100
  }));

const sections = [
  { title: 'Pagos', service: 'payments', cards: generateCards(data.payments) },
  { title: 'Logística', service: 'logistic', cards: generateCards(data.logistic) },
  { title: 'Consumer', service: 'consumer', cards: generateCards(data.consumer) },
];

// Calcular estadísticas generales
const totalServices = sections.reduce((acc, section) => acc + section.cards.length, 0);
const healthyServices = sections.reduce((acc, section) =>
  acc + section.cards.filter(card => card.status === 'Healthy').length, 0);
const warningServices = sections.reduce((acc, section) =>
  acc + section.cards.filter(card => card.status === 'Warning').length, 0);
const criticalServices = sections.reduce((acc, section) =>
  acc + section.cards.filter(card => card.status === 'Critical').length, 0);

// Calcular estadísticas de SLA
const totalSLAs = mockSLAs.length;
const compliantSLAs = mockSLAs.filter(sla => sla.uptime >= sla.target).length;
const nonCompliantSLAs = totalSLAs - compliantSLAs;
const averageUptime = mockSLAs.reduce((acc, sla) => acc + sla.uptime, 0) / totalSLAs;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard Healthcheck</title>
    <style>
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .animate-fade-in {
        animation: fadeInUp 0.6s ease-out;
      }

      .hover-scale {
        transition: all 0.3s ease;
      }

      .hover-scale:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -5px rgba(0, 0, 0, 0.04);
      }

      /* logout boton csss */
      .logout-btn {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-left: 1rem;
      }

      .logout-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
      }

      .user-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: #6b7280;
      }

      .welcome-banner {
        background: linear-gradient(135deg, #ea6690 0%, #a24b64 100%);
        color: white;
        padding: 1rem;
        border-radius: 0.75rem;
        margin-bottom: 1.5rem;
        text-align: center;
      }

      .welcome-banner h2 {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0;
      }

      .welcome-banner p {
        margin: 0.5rem 0 0 0;
        opacity: 0.9;
      }
    </style>
  </head>

  <body class="bg-indigo-50 min-h-screen">
    <div class="main-content">
    <Header title="Dashboard Healthcheck"  isLoading={false} />

    <div class=" mx-auto px-4 py-6">
      
      {/* banner para dar la bienvenida al mejor healthcheck 
      <div class="welcome-banner animate-fade-in shadow-lg">
        <h2>¡Bienvenido al mejor Healthcheck del mundo! 🦁</h2>
        <p>Team LINCES - Monitoreando servicios con excelencia</p>
      </div> */}

      <!-- Resumen General -->
      <div class="mb-8 animate-fade-in">
        <div class="bg-white overflow-hidden rounded-xl shadow-lg">
          <div class="px-6 pt-4">
            <div class="flex items-center">
              <div class="bg-gradient-to-r from-blue-500 to-cyan-500 rounded-lg p-2 mr-3">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-bold text-gray-800">Resumen del Sistema</h3>
                <p class="text-xs text-gray-500">Estado general de todos los proyectos</p>
              </div>
            </div>
          </div>

          <!-- metricas principales -->
          <div class="p-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
              <!-- total de servicios -->
              <div class="bg-blue-50 rounded-xl p-4 border border-blue-200">
                <div class="flex items-center">
                  <div class="bg-gradient-to-r from-blue-600 to-blue-400 rounded-lg p-2 mr-4">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-sm font-medium text-blue-800">Total Proyectos</h3>
                    <p class="text-xl font-bold text-blue-900">{totalServices}</p>
                    <p class="text-xs text-blue-600">Proyectos monitoreados</p>
                  </div>
                </div>
              </div>

              <!-- servicio saludable -->
              <div class="bg-green-50 rounded-xl p-4 border border-green-200">
                <div class="flex items-center">
                  <div class="bg-gradient-to-r from-green-600 to-green-400 rounded-lg p-2 mr-4">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-sm font-medium text-green-800">Proyectos Online</h3>
                    <p class="text-xl font-bold text-green-900">{healthyServices}</p>
                    <p class="text-xs text-green-600">Funcionando correctamente</p>
                  </div>
                </div>
              </div>

              <!-- servicios con advertencia -->
              <div class="bg-yellow-50 rounded-xl p-4 border border-yellow-200">
                <div class="flex items-center">
                  <div class="bg-gradient-to-r from-yellow-500 to-yellow-300 rounded-lg p-2 mr-4">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-sm font-medium text-yellow-800">Proyectos Con Advertencias</h3>
                    <p class="text-xl font-bold text-yellow-900">{warningServices}</p>
                    <p class="text-xs text-yellow-600">Requieren atención</p>
                  </div>
                </div>
              </div>

              <!-- servicios criticos -->
              <div class="bg-red-50 rounded-xl p-4 border border-red-200">
                <div class="flex items-center">
                  <div class="bg-gradient-to-r from-red-600 to-red-400 rounded-lg p-2 mr-4">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-sm font-medium text-red-800">Proyectos Críticos</h3>
                    <p class="text-xl font-bold text-red-900">{criticalServices}</p>
                    <p class="text-xs text-red-600">Necesitan intervención</p>
                  </div>
                </div>
              </div>

              <!-- SLA Compliance -->
              <div class={`rounded-xl p-4 border ${
                compliantSLAs === totalSLAs ? 'bg-green-50 border-green-200' : 
                nonCompliantSLAs > 0 ? 'bg-red-50 border-red-200' : 'bg-yellow-50 border-yellow-200'
              }`}>
                <div class="flex items-center">
                  <div class={`rounded-lg p-2 mr-4 ${
                    compliantSLAs === totalSLAs ? 'bg-gradient-to-r from-green-600 to-green-400' :
                    nonCompliantSLAs > 0 ? 'bg-gradient-to-r from-red-600 to-red-400' : 'bg-gradient-to-r from-yellow-500 to-yellow-300'
                  }`}>
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class={`text-sm font-medium ${
                      compliantSLAs === totalSLAs ? 'text-green-800' :
                      nonCompliantSLAs > 0 ? 'text-red-800' : 'text-yellow-800'
                    }`}>SLA Compliance</h3>
                    <p class={`text-xl font-bold ${
                      compliantSLAs === totalSLAs ? 'text-green-900' :
                      nonCompliantSLAs > 0 ? 'text-red-900' : 'text-yellow-900'
                    }`}>{compliantSLAs}/{totalSLAs}</p>
                    <p class={`text-xs ${
                      compliantSLAs === totalSLAs ? 'text-green-600' :
                      nonCompliantSLAs > 0 ? 'text-red-600' : 'text-yellow-600'
                    }`}>Cumplen SLA ({averageUptime.toFixed(1)}% avg)</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- info extra -->
          <div class="px-6 pb-6 grid grid-cols-1 lg:grid-cols-3 gap-6 animate-fade-in">
            {sections.map((section) => (
              <div class={`bg-white rounded-xl shadow-sm border p-5 ${
                  section.service === 'payments' ? 'border-green-200' :
                  section.service === 'logistic' ? 'border-blue-200' : 'border-purple-200'
                }`}>
                <div class="flex items-center mb-4">
                  <div class={`rounded-lg p-2 mr-3 ${
                    section.service === 'payments' ? 'bg-green-600' :
                    section.service === 'logistic' ? 'bg-blue-600' : 'bg-purple-600'
                  }`}>
                    {section.service === 'payments' && (
                      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                      </svg>
                    )}
                    {section.service === 'logistic' && (
                      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                      </svg>
                    )}
                    {section.service === 'consumer' && (
                      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                      </svg>
                    )}
                  </div>
                  <div>
                    <h3 class={`text-sm font-semibold ${
                      section.service === 'payments' ? 'text-green-700' :
                      section.service === 'logistic' ? 'text-blue-700' : 'text-purple-700'}`
                    }>{section.title}</h3>
                    <p class={`text-xs ${
                      section.service === 'payments' ? 'text-green-500' :
                      section.service === 'logistic' ? 'text-blue-500' : 'text-purple-500'}`
                    }>{section.cards.length} proyectos</p>
                  </div>
                </div>

                <div class="space-y-2">
                  <div class="flex justify-between items-center">
                    <span class="text-sm font-semibold text-gray-600">Online:</span>
                    <span class="text-sm font-semibold text-green-600">
                      {section.cards.filter(card => card.status === 'Healthy').length}
                    </span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-sm font-semibold text-gray-600">Advertencias:</span>
                    <span class="text-sm font-semibold text-yellow-600">
                      {section.cards.filter(card => card.status === 'Warning').length}
                    </span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-sm font-semibold text-gray-600">Críticos:</span>
                    <span class="text-sm font-semibold text-red-600">
                      {section.cards.filter(card => card.status === 'Critical').length}
                    </span>
                  </div>
                </div>

                <div class="mt-4">
                  {(() => {
                    const healthyCount = section.cards.filter(card => card.status === 'Healthy').length;
                    const warningCount = section.cards.filter(card => card.status === 'Warning').length;
                    const criticalCount = section.cards.filter(card => card.status === 'Critical').length;
                    
                    // para calcular lo q se resta de la barra
                    let basePercentage = 100;
                    basePercentage -= (criticalCount * 50); 
                    basePercentage -= (warningCount * 25);  
                    
                    const finalPercentage = Math.max(0, basePercentage);
                    
                    let barColor = 'bg-gradient-to-r from-green-500 to-green-600';
                    let statusText = 'Excelente';
                    
                    if (criticalCount > 0) {
                      barColor = 'bg-gradient-to-r from-green-500 to-red-500'; 
                      statusText = 'Crítico';
                    } else if (warningCount > 0) {
                      barColor = 'bg-gradient-to-r from-green-500 to-yellow-500'; 
                      statusText = 'Advertencia';
                    } else if (finalPercentage === 100) {
                      statusText = 'Perfecto';
                    }
                    
                    return (
                      <>
                        <div class="flex justify-between text-xs text-gray-600 mb-1">
                          <span>Estado General - {statusText}</span>
                          <span>{finalPercentage}%</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                          <div 
                            class={`h-2 rounded-full ${barColor} transition-all duration-500`}
                            style={`width: ${finalPercentage}%`}
                          ></div>
                        </div>
                      </>
                    );
                  })()}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

       <!-- SLA Monitoring Section -->
       <div class="mb-8 animate-fade-in">
        <SLAStatus slas={mockSLAs} />
      </div>

      <!-- el panel de tabs -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden animate-fade-in">
        <div class="px-6 py-4 bg-white">
          <div class="flex items-center">
            <div class="bg-gradient-to-r from-purple-600 to-pink-600 rounded-lg p-2 mr-3">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-sm font-bold text-gray-800">Servicios por Categoría</h2>
              <p class="text-xs text-gray-500">Detalle del estado de cada categoría de servicios</p>
            </div>
          </div>
        </div>

        <!-- tab layout -->
        <div class="px-5 pb-5">
          <Tabs titles={sections.map(section => section.title)}>
            {sections.map((section, index) => (
              <TabItem index={index} title={section.title} active={index === 0}>
                <TabContent service={section.service} items={section.cards} />
              </TabItem>
            ))}
          </Tabs>
        </div>
      </div>

     <!-- <div class="mt-4 text-center">
        <p class="text-sm text-gray-600 italic">"Juntos somos LINCES, juntos construimos el mejor healthcheck del mundo 🦁"</p>
      </div> -->
    </div>

    <script>
      // para ver si tas conectado
      document.addEventListener('DOMContentLoaded', function() {
        const authToken = localStorage.getItem('authToken');
        const userInfo = localStorage.getItem('userInfo');
        
        if (!authToken) {
          window.location.href = '/login';
          return;
        }
        
        // info del usuario
        if (userInfo) {
          try {
            const user = JSON.parse(userInfo);
            const greeting = document.getElementById('userGreeting');
            if (greeting) {
              greeting.textContent = `¡Hola, ${user.username}!`;
            }
          } catch (e) {
            console.error('Error parsing user info:', e);
          }
        }
      });
    </script>
  </body>
</html>