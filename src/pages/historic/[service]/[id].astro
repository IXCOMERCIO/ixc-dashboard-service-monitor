---
import StepBack from "../../../components/hooks/StepBack.astro";
import Header from "../../../components/layouts/Header.astro";
import { BASE_DASHBOARD_URL } from "astro:env/server";
import PerformanceChart from "../../../components/statistics/PerformanceChart.jsx";
import Card from "../../../components/utils/Card.jsx";

const { service, id } = Astro.params;

if (!service || !id) {
  throw new Error("Los parámetros 'service' o 'id' no están definidos.");
}

const apiUrlStatistics = `${BASE_DASHBOARD_URL}/history/statistics?team=${service}&project=${id}&days=30`;
const apiUrlErrors = `${BASE_DASHBOARD_URL}/history/errors?team=${service}&project=${id}&limit=10&page=1&days=30`;
const apiUrlServices = `${BASE_DASHBOARD_URL}/status/${service}/${id}`;

let statisticsData: any = null;
let errorData: any = null;
let servicesData: any = null;
//const subservices = service.subservices as SubService[];

try {
  const statisticsRes = await fetch(apiUrlStatistics);
  const errorsRes = await fetch(apiUrlErrors);
  const servicesRes = await fetch(apiUrlServices);

  if (!statisticsRes.ok) {
    throw new Error(`Failed to fetch data from ${apiUrlStatistics}`);
  }

  if (!errorsRes.ok) {
    throw new Error(`Failed to fetch data from ${apiUrlErrors}`);
  }

  if (!servicesRes.ok) {
    throw new Error(`Failed to fetch data from ${apiUrlServices}`);
  }

  statisticsData = await statisticsRes.json();
  errorData = await errorsRes.json();
  servicesData = await servicesRes.json();
} catch (error) {
  console.error("Error fetching service details:", error);
}

function formatDate(dateString: string) {
  const date = new Date(dateString);
  return date.toLocaleString(undefined, {
    day: "2-digit",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false,
  });
}

const statusColor = {
  healthy: "bg-green-500",
  warning: "bg-yellow-500",
  critical: "bg-red-500",
};

//const isDetail = false;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body
    class="bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 min-h-screen"
  >
    <Header
      title={servicesData[service][id].title}
      subtitle="Detalle de Servicio"
    />

    <div class="mx-auto px-4 my-2">
      <StepBack title="Dashboard" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-2">
        <!-- Disponibilidad -->
        <Card
          title="Disponibilidad (30d)"
          value={`${statisticsData.statistics.availabilityPercentage}%`}
          color="green"
        />
        <!-- Tiempo de respuesta promedio -->
        <Card
          title="T. Respuesta Promedio (30d)"
          value={`${statisticsData.statistics.averageResponseTime}ms`}
          color="blue"
        />
        <Card
          title="Total Servicios (30d)"
          value={statisticsData.statistics.totalServices}
          color="yellow"
        />
        <!-- Total Errores -->
        <Card
          title="Total Errores (30d)"
          value={statisticsData.statistics.downtimeServices}
          color="red"
        />
        <!-- Incidentes Críticos -->
      </div>
    </div>

    <PerformanceChart client:only="react" />

    <!-- Sección de Servicios y Errores -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-8">
      <!-- Servicios -->
      <div class="bg-white border rounded-lg shadow-sm p-4 ml-6 mb-6">
        <div class="font-semibold text-lg mb-4">Servicios</div>
        <ul>
          {
            Object.values(servicesData[service][id].services)?.map(
              (svc: any) => (
                <li class="flex items-center justify-between py-2 border-b last:border-b-0">
                  <div class="flex items-center gap-2">
                    <span
                      class={`w-3 h-3 rounded-full ${statusColor[svc.overallStatus?.status]} inline-block`}
                    />
                    <span class="text-sm">{svc.serviceName}</span>
                  </div>
                  <span class="text-sm">{svc.executionTime ?? 0}</span>
                </li>
              )
            )
          }
        </ul>
      </div>

      <!-- Registro de Errores Recientes -->
      <div class="bg-white border rounded-lg shadow-sm p-4 mr-6 mb-6">
        <div class="font-semibold text-lg mb-4">
          Registro de Errores Recientes
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead>
              <tr class="bg-gray-50 text-gray-500 uppercase text-xs">
                <th class="py-2 px-2 text-left">Estado</th>
                <th class="py-2 px-2 text-left">Fecha y Hora</th>
                <th class="py-2 px-2 text-left">Servicio Afectado</th>
                <th class="py-2 px-2 text-left">Código de Estado</th>
                <th class="py-2 px-2 text-left">Mensaje</th>
              </tr>
            </thead>
            <tbody>
              {
                errorData.data?.map((err) => (
                  <tr class="border-b last:border-b-0">
                    <td class="py-2 px-2">
                      {err.status === 503 && (
                        <span class="w-3 h-3 rounded-full bg-red-500 inline-block" />
                      )}
                      {err.status === 404 && (
                        <span class="w-3 h-3 rounded-full bg-yellow-400 inline-block" />
                      )}
                      {err.status !== 503 && err.status !== 404 && (
                        <span class="w-3 h-3 rounded-full bg-yellow-400 inline-block" />
                      )}
                    </td>
                    <td class="py-2 px-2 whitespace-nowrap">
                      {formatDate(err.date)}
                    </td>
                    <td class="py-2 px-2">{err.serviceName}</td>
                    <td class="py-2 px-2">
                      <span
                        class={`px-2 py-1 rounded text-xs font-mono ${err.status === 503 ? "bg-red-100 text-red-600" : err.status === 404 ? "bg-yellow-100 text-yellow-700" : "bg-yellow-100 text-yellow-700"}`}
                      >
                        {err.status === "ECONNRESET"
                          ? "ECONNRESET"
                          : err.status}
                      </span>
                    </td>
                    <td class="py-2 px-2">{err.message}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <div class="text-xs text-gray-500 mt-2">
            Mostrando 1-{
              errorData.pagination.limit * errorData.pagination.currentPage
            } de {errorData.pagination.totalRecords ?? 0}
          </div>
          <!--<div class="flex justify-end mt-2">
      <button
        class="border rounded px-2 py-1 text-gray-500 hover:bg-gray-100 mr-2"
        disabled
      >
        &lt;
      </button>
      <button class="border rounded px-2 py-1 text-gray-500 hover:bg-gray-100">
        &gt;
      </button>
    </div>
    -->
        </div>
      </div>
    </div>
  </body>
</html>
