---
import StepBack from "../../../components/hooks/StepBack.astro";
import Header from "../../../components/layouts/Header.astro";
import ServiceStatus from "../../../components/services/ServiceStatus.astro";
import {
    paymentCards,
    logisticsCards,
    portalCards,
} from "../../../data/mockData";
import type { SubService } from "../../../data/mockData.ts";
import PerformanceChart from "../../../components/statistics/PerformanceChart.jsx";
import Card from "../../../components/utils/Card.jsx";

const { id } = Astro.params;
const allCards = [...paymentCards, ...logisticsCards, ...portalCards];
const service = allCards.find((item) => item.id === id);

if (!service) {
    throw new Error(`Servicio con ID ${id} no encontrado.`);
}

const subservices = service.subservices as SubService[];
const isDetail = false;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{service.title} - Detalle de Servicio</title>
</head>
<body>

<StepBack title="Regresar al dashboard" />
<Header title={service.title} subtitle="Detalle de Servicio" />

<div class="mx-auto px-4 mt-6">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Disponibilidad -->
    <div class="bg-white border rounded-lg shadow-sm p-6 flex flex-col items-start">
      <div class="text-sm text-gray-500 mb-1">Disponibilidad (24h)</div>
      <div class="text-3xl font-bold text-green-600 mb-1">99.92%</div>
      <div class="text-xs text-gray-500">Sin caídas mayores en el período</div>
    </div>
    <!-- Tiempo de respuesta promedio -->
    <Card title="T. Respuesta Promedio (24h)" value="148 ms" description="Dentro de los parámetros normales" color="blue" />
    
    <!-- Total Errores -->
    <Card title="Total Errores (24h)" value="12" description="Mayormente errores no críticos" color="yellow" />
    <!-- Incidentes Críticos -->
    <Card title="Incidentes Críticos (24h)" value="1" description="Resuelto en 5 minutos" color="red" />
  </div>
</div>

<PerformanceChart client:only="react" />

<!-- Sección de Servicios y Errores -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-8">
  <!-- Servicios del Orquestador -->
  <div class="bg-white border rounded-lg shadow-sm p-4">
    <div class="font-semibold text-lg mb-4">Servicios del Orquestador</div>
    <ul>
      {subservices.map((svc) => (
        <li class="flex items-center justify-between py-2 border-b last:border-b-0">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>
            <span class="truncate max-w-[180px]">{svc.name}</span>
          </div>
          <span class="text-gray-500 text-sm">{svc.executionTime ?? 0}ms</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Registro de Errores Recientes -->
  <div class="bg-white border rounded-lg shadow-sm p-4">
    <div class="font-semibold text-lg mb-4">Registro de Errores Recientes</div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="bg-gray-50 text-gray-500 uppercase text-xs">
            <th class="py-2 px-2 text-left">Estado</th>
            <th class="py-2 px-2 text-left">Fecha y Hora</th>
            <th class="py-2 px-2 text-left">Servicio Afectado</th>
            <th class="py-2 px-2 text-left">Código de Estado</th>
            <th class="py-2 px-2 text-left">Mensaje</th>
          </tr>
        </thead>
        <tbody>
          {service.errors?.slice(0, 3).map((err) => (
            <tr class="border-b last:border-b-0">
              <td class="py-2 px-2">
                {err.status === 503 && <span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span>}
                {err.status === 404 && <span class="w-3 h-3 rounded-full bg-yellow-400 inline-block"></span>}
                {err.status !== 503 && err.status !== 404 && <span class="w-3 h-3 rounded-full bg-yellow-400 inline-block"></span>}
              </td>
              <td class="py-2 px-2 whitespace-nowrap">{err.date}</td>
              <td class="py-2 px-2">{err.serviceName}</td>
              <td class="py-2 px-2">
                <span class={`px-2 py-1 rounded text-xs font-mono ${err.status === 503 ? 'bg-red-100 text-red-600' : err.status === 404 ? 'bg-yellow-100 text-yellow-700' : 'bg-yellow-100 text-yellow-700'}`}>
                  {err.status === 'ECONNRESET' ? 'ECONNRESET' : err.status}
                </span>
              </td>
              <td class="py-2 px-2">{err.message}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="text-xs text-gray-500 mt-2">
        Mostrando 1-3 de {service.errors?.length ?? 0}
      </div>
      <div class="flex justify-end mt-2">
        <button class="border rounded px-2 py-1 text-gray-500 hover:bg-gray-100 mr-2" disabled>
          &lt;
        </button>
        <button class="border rounded px-2 py-1 text-gray-500 hover:bg-gray-100">
          &gt;
        </button>
      </div>
    </div>
  </div>
</div>

</body>
</html>