<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Seleccionar Gerencia - Healthcheck Dashboard</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
    }

    .container {
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(12px);
      padding: 3rem;
      border-radius: 1.5rem;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
      width: 100%;
      max-width: 800px;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .header {
      text-align: center;
      margin-bottom: 2.5rem;
    }

    .logo {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 4rem;
      height: 4rem;
      background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
      border-radius: 1rem;
      margin-bottom: 1.5rem;
      font-size: 1.5rem;
      box-shadow: 0 8px 20px rgba(249, 115, 22, 0.3);
    }

    .title {
      font-size: 2rem;
      font-weight: 700;
      color: #1f2937;
      margin-bottom: 0.5rem;
    }

    .subtitle {
      color: #6b7280;
      font-size: 1rem;
      font-weight: 500;
    }

    .gerencias-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin-bottom: 2rem;
    }

    .gerencia-card {
      border: 2px solid #e5e7eb;
      border-radius: 1rem;
      padding: 2rem 1.5rem;
      cursor: pointer;
      transition: all 0.2s ease;
      background: white;
      min-height: 180px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      position: relative;
    }

    .gerencia-card:hover {
      border-color: #6366f1;
      transform: translateY(-4px);
      box-shadow: 0 12px 25px rgba(99, 102, 241, 0.15);
    }

    .gerencia-card.selected {
      border-color: #6366f1;
      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
      color: white;
      transform: translateY(-4px);
      box-shadow: 0 15px 30px rgba(99, 102, 241, 0.25);
    }

    .gerencia-card.coming-soon::after {
      content: '🚧';
      position: absolute;
      top: 1rem;
      right: 1rem;
      font-size: 1.2rem;
      opacity: 0.7;
    }

    .gerencia-icon {
      font-size: 2.5rem;
      margin-bottom: 1rem;
      display: block;
    }

    .gerencia-name {
      font-size: 1.2rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      line-height: 1.3;
    }

    .gerencia-description {
      font-size: 0.9rem;
      line-height: 1.5;
      opacity: 0.8;
      flex-grow: 1;
      display: flex;
      align-items: center;
    }

    .gerencia-card.selected .gerencia-description {
      opacity: 0.95;
    }

    .continue-btn {
      width: 100%;
      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
      color: white;
      padding: 1rem 2rem;
      border: none;
      border-radius: 0.75rem;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      opacity: 0.5;
      pointer-events: none;
    }

    .continue-btn.enabled {
      opacity: 1;
      pointer-events: auto;
      box-shadow: 0 8px 20px rgba(99, 102, 241, 0.3);
    }

    .continue-btn.enabled:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 25px rgba(99, 102, 241, 0.4);
    }

    .footer {
      text-align: center;
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid #e5e7eb;
    }

    .footer p {
      font-size: 0.8rem;
      color: #6b7280;
      margin-bottom: 0.25rem;
    }

    .footer .team-motto {
      font-style: italic;
      color: #9ca3af;
    }

    .popup-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
      padding: 1rem;
    }

    .popup-overlay.show {
      opacity: 1;
      visibility: visible;
    }

    .popup {
      background: white;
      padding: 2.5rem;
      border-radius: 1.5rem;
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
      text-align: center;
      max-width: 450px;
      width: 100%;
      transform: scale(0.9);
      transition: transform 0.3s ease;
    }

    .popup-overlay.show .popup {
      transform: scale(1);
    }

    .popup-icon {
      font-size: 3.5rem;
      margin-bottom: 1rem;
      display: block;
    }

    .popup-title {
      font-size: 1.8rem;
      font-weight: 700;
      color: #1f2937;
      margin-bottom: 1rem;
    }

    .popup-message {
      font-size: 1rem;
      color: #6b7280;
      line-height: 1.6;
      margin-bottom: 2rem;
    }

    .popup-btn {
      background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
      color: white;
      padding: 0.75rem 2rem;
      border: none;
      border-radius: 0.75rem;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 6px 15px rgba(249, 115, 22, 0.3);
    }

    .popup-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(249, 115, 22, 0.4);
    }

    @media (min-width: 768px) {
      .gerencias-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (max-width: 768px) {
      .container {
        padding: 2rem 1.5rem;
      }

      .title {
        font-size: 1.8rem;
      }

      .gerencia-card {
        padding: 1.5rem;
        min-height: 160px;
      }

      .gerencia-icon {
        font-size: 2rem;
      }

      .gerencia-name {
        font-size: 1.1rem;
      }

      .gerencia-description {
        font-size: 0.85rem;
      }

      .popup {
        padding: 2rem;
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="header">
      <!-- <div class="logo">🦁</div> -->
      <h1 class="title">¡Bienvenido!</h1>
      <p class="subtitle">Selecciona tu gerencia para continuar</p>
    </div>

    <div class="gerencias-grid">
      <div class="gerencia-card" data-gerencia="omnichannel">
        <span class="gerencia-icon">🌐</span>
        <h3 class="gerencia-name">Omnichannel</h3>
        <p class="gerencia-description">
          Gestión integral de canales de venta y experiencia del cliente
        </p>
      </div>

      <div class="gerencia-card coming-soon" data-gerencia="merchandising">
        <span class="gerencia-icon">📊</span>
        <h3 class="gerencia-name">ERP & Merchandising</h3>
        <p class="gerencia-description">
          Estrategia de productos, precios y promociones
        </p>
      </div>

      <div class="gerencia-card coming-soon" data-gerencia="ecommerce">
        <span class="gerencia-icon">🛒</span>
        <h3 class="gerencia-name">Ecommerce</h3>
        <p class="gerencia-description">
          Plataforma digital y comercio electrónico
        </p>
      </div>
    </div>

    <button class="continue-btn" id="continueBtn">
      Continuar al Dashboard
    </button>

    <div class="footer">
      <p>© 2025 Dashboard Healthcheck</p>
       <p class="team-motto">"Juntos somos LINCES, juntos construimos el mejor healthcheck del mundo 🦁"</p>
    </div>
  </div>

  <div class="popup-overlay" id="constructionPopup">
    <div class="popup">
      <span class="popup-icon">🚧</span>
      <h2 class="popup-title">¡En Construcción!</h2>
      <p class="popup-message">
        Estamos trabajando para usted en esta sección.<br>
        Pronto tendrá disponible el dashboard de <strong id="gerenciaName"></strong>.
      </p>
      <button class="popup-btn" id="popupBtn">
        Entendido
      </button>
    </div>
  </div>

  <script>
    const gerenciaNames = {
      'merchandising': 'ERP & Merchandising',
      'ecommerce': 'Ecommerce'
    };

    let selectedGerencia = null;

    function resetSelection() {
      document.querySelectorAll('.gerencia-card').forEach(card => card.classList.remove('selected'));
      document.getElementById('continueBtn').classList.remove('enabled');
      document.getElementById('continueBtn').textContent = 'Continuar al Dashboard';
      selectedGerencia = null;
    }

    function showConstructionPopup(gerencia) {
      document.getElementById('gerenciaName').textContent = gerenciaNames[gerencia] || gerencia;
      document.getElementById('constructionPopup').classList.add('show');
    }

    function closeConstructionPopup() {
      document.getElementById('constructionPopup').classList.remove('show');
      resetSelection();
    }

    function handleCardClick(card) {
      document.querySelectorAll('.gerencia-card').forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      selectedGerencia = card.dataset.gerencia;
      
      const continueBtn = document.getElementById('continueBtn');
      continueBtn.classList.add('enabled');
      continueBtn.textContent = selectedGerencia === 'omnichannel' 
        ? 'Continuar al Dashboard' 
        : 'Ver Información';
    }

    function handleContinueClick() {
      if (!selectedGerencia) return;

      if (selectedGerencia === 'omnichannel') {
        const userInfo = JSON.parse(localStorage.getItem('userInfo') || '{}');
        userInfo.gerencia = selectedGerencia;
        localStorage.setItem('userInfo', JSON.stringify(userInfo));
        window.location.href = '/';
      } else {
        showConstructionPopup(selectedGerencia);
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      if (!localStorage.getItem('authToken')) {
        window.location.href = '/login';
        return;
      }

      document.querySelectorAll('.gerencia-card').forEach(card => {
        card.addEventListener('click', () => handleCardClick(card));
      });

      document.getElementById('continueBtn').addEventListener('click', handleContinueClick);
      document.getElementById('popupBtn').addEventListener('click', closeConstructionPopup);
      
      document.getElementById('constructionPopup').addEventListener('click', function(e) {
        if (e.target === this) closeConstructionPopup();
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeConstructionPopup();
      });
    });
  </script>
</body>
</html>